{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dj-digger.local/schemas/v1/curation-result.schema.json",
  "title": "DJ Digger curation result",
  "description": "Versioned envelope for set and playlist curation. DJ Digger-attested facts are separated from LLM explanations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "type", "status", "identity", "prompt", "tracks", "transitions", "warnings", "report", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "https://dj-digger.local/schemas/v1/curation-result.schema.json"},
    "type": {"enum": ["set", "playlist"]},
    "status": {"enum": ["draft", "validated", "published", "failed"]},
    "identity": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/canonical_track"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report": {"$ref": "#/$defs/report"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "track_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "track_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "track_id": {"type": "integer", "minimum": 1}
      }
    },
    "canonical_track": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "identity", "role"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "identity": {"$ref": "#/$defs/track_identity"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "explanation"],
      "properties": {
        "from": {"$ref": "#/$defs/track_identity"},
        "to": {"$ref": "#/$defs/track_identity"},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "fact", "track_positions"],
      "properties": {
        "source": {"const": "dj_digger"},
        "fact": {"type": "string", "minLength": 1},
        "track_positions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "attested_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "attested_facts", "llm_explanations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "attested_facts": {"type": "array", "items": {"$ref": "#/$defs/attested_fact"}},
        "llm_explanations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "model", "generated_at", "catalog_snapshot"],
      "properties": {
        "generator": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "catalog_snapshot": {"type": "string", "minLength": 1}
      }
    }
  }
}
