{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v codegraph >/dev/null 2>&1; then exec codegraph prompt-hook; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/stop-protect-local"
          }
        ]
      }
    ]
  }
}
